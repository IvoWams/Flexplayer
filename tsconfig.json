{
    "compilerOptions": {
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "module": "commonjs",
        "target": "es5",
        "lib": [
            "es5", "es6"
        ],
        "noImplicitAny": true,
        "removeComments": true,
        "preserveConstEnums": true,
        "outDir": "bin/",
        "sourceMap": true,
        "diagnostics": true
    },
    "include": [
        "src/**/*"
    ]
}