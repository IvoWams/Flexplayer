{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch",
			"outFiles": [
				"${workspaceRoot}/bin/**/*.js"
			],
			"type": "node",
			"request": "launch",
			"program": "${workspaceRoot}/src/main.ts",
			"stopOnEntry": true,
			"args": [],
			"cwd": "${workspaceRoot}",
			"env": {
				"NODE_ENV": "development"
			},
			"runtimeArgs": [
				"--nolazy"
			]
		},
		{
			"name": "Attach",
			"type": "node",
			"request": "attach",
			"port": 5858
		}
	]
}